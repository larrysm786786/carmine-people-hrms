# Copy this file to .env and fill in real values. Never commit .env — it's gitignored.
# These map to ASP.NET Core configuration keys using the standard "__" section-separator
# convention (e.g. JWT_SIGNING_KEY -> Jwt:SigningKey, AI_ANTHROPIC_API_KEY -> Ai:Anthropic:ApiKey).

# Database — local Postgres for docker-compose (POSTGRES_PASSWORD), or a Supabase
# Postgres connection string for staging/production (DATABASE_CONNECTION). Supabase gives
# you this string under Project Settings > Database > Connection string (use the pooler
# connection string for serverless/App platforms like Render).
POSTGRES_PASSWORD=ChangeMe_Str0ngP@ssw0rd
DATABASE_CONNECTION=Host=localhost;Port=5432;Database=CarminePeopleDb;Username=postgres;Password=ChangeMe_Str0ngP@ssw0rd

# JWT authentication — SigningKey must be a real random secret (32+ chars) in any
# non-Development environment; the app refuses to start otherwise (see Program.cs).
JWT_SIGNING_KEY=REPLACE_WITH_A_STRONG_SECRET_AT_LEAST_32_CHARS_LONG
JWT_ISSUER=CarminePeople
JWT_AUDIENCE=CarminePeopleClients
# How long an access token stays valid before the client must use its refresh token.
JWT_ACCESS_TOKEN_MINUTES=15

# Comma-free list — one origin per numbered key (Cors__AllowedOrigins__0, __1, __2, ...)
# is how ASP.NET Core config binds an array from environment variables. Set these to the
# real admin dashboard / mobile app origins in staging and production; the app rejects
# any browser origin not in this list.
CORS_ALLOWED_ORIGIN_0=http://localhost:4200

# Document storage (local disk in dev; swap for Azure Blob connection string in production)
STORAGE_ROOT_PATH=App_Data/documents

# Push notifications (Firebase Cloud Messaging) — until a service account is configured,
# push sends are logged instead of dispatched (see FirebasePushNotificationSender.cs)
FCM_SERVICE_ACCOUNT_JSON=

# AI Assistant (Anthropic Claude) — required for the AI Assistant feature; the feature
# reports itself as "not configured" and degrades gracefully if this is left blank
AI_ANTHROPIC_API_KEY=
# Optional overrides — leave unset to use the appsettings.json defaults
# (claude-sonnet-4-5-20250929, 1024 max tokens).
AI_ANTHROPIC_MODEL=
AI_ANTHROPIC_MAX_TOKENS=
